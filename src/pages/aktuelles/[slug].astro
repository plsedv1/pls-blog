---
import Layout from '../../layouts/Layout.astro';

// Alle Projekte laden
const allProjects = await Astro.glob('../projekte/*.md');

// Projekt nach Slug finden
const { slug } = Astro.params;
const project = allProjects.find((p) => {
  const filePath = p.file || '';
  const fileName = filePath.split('/').pop() || '';
  const projectSlug = fileName.replace(/\.md$/, '');
  return projectSlug === slug;
});

if (!project) {
  return Astro.redirect('/aktuelles', 404);
}

const frontmatter = project.frontmatter;
const content = project.Content;
---

<Layout
  pageTitle={`Projekt: ${frontmatter.title ?? ""} | PLS EDV`}
  description={frontmatter.description ?? ''}
  ogImage={frontmatter.image?.url ?? '/images/og-default.jpg'}
  type="article"
  keywords={frontmatter.tags || []}
>
  <!-- Hero -->
  <section
    class="relative isolate text-white bg-cover bg-top flex items-end min-h-[35svh] md:min-h-[45vh]"
    style={`background-image:url('${frontmatter.image?.url ?? "/images/placeholder-1600x900.jpg"}')`}
  >
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative z-10 mx-auto w-[75vw] py-10 md:py-16">
      <h1 class="font-heading text-3xl md:text-5xl font-bold tracking-wide">{frontmatter.title}</h1>
      {frontmatter.description && <p class="mt-3 max-w-3xl text-white/90">{frontmatter.description}</p>}
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-white/80">
        {frontmatter.pubDate && <span>{new Date(frontmatter.pubDate).toLocaleDateString("de-DE")}</span>}
        {frontmatter.author && <span>– {frontmatter.author}</span>}
      </div>
    </div>
  </section>

  <!-- Content -->
  <article class="mx-auto w-[75vw] py-10 md:py-16 prose prose-invert max-w-none">
    {project.Content && <project.Content />}
  </article>

  <!-- CTA -->
  <div class="mx-auto w-[75vw] pb-16 flex gap-4">
    <a href="/aktuelles" class="rounded border border-white/20 px-4 py-2 hover:bg-white/10">← Zur Übersicht</a>
    <a href="/kontakt" class="rounded bg-white text-ink px-4 py-2 hover:bg-gray-100">Projekt anfragen</a>
  </div>
</Layout>
