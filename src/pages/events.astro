---
// src/pages/events.astro
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// Events Calendar API
const EVENTS_API = 'https://was-wo-finden.de/wp-json/tribe/events/v1/events';

/** Typen */
type EventImage = {
  url: string;
  id: number;
  width: number;
  height: number;
  sizes?: {
    medium?: { url: string; width: number; height: number };
    medium_large?: { url: string; width: number; height: number };
    thumbnail?: { url: string; width: number; height: number };
    [key: string]: { url: string; width: number; height: number } | undefined;
  };
};

type EventVenue = {
  id: number;
  venue: string;
  address?: string;
  city?: string;
  phone?: string;
  website?: string;
};

type EventOrganizer = {
  id: number;
  organizer: string;
  phone?: string;
  website?: string;
};

type EventCategory = {
  name: string;
  slug: string;
};

type Event = {
  id: number;
  title: string;
  description: string;
  excerpt: string;
  url: string;
  slug: string;
  image?: EventImage;
  start_date: string;
  start_date_details: {
    year: string;
    month: string;
    day: string;
    hour: string;
    minutes: string;
  };
  end_date: string;
  end_date_details: {
    year: string;
    month: string;
    day: string;
    hour: string;
    minutes: string;
  };
  all_day: boolean;
  venue?: EventVenue;
  organizer?: EventOrganizer[];
  categories?: EventCategory[];
  cost?: string;
};

type EventsResponse = {
  events: Event[];
  total?: number;
  total_pages?: number;
};

/** Hilfsfunktionen */
const stripTags = (html: string | undefined) =>
  (html ?? '')
    .replace(/<script[\s\S]*?>[\s\S]*?<\/script>/gi, '')
    .replace(/<style[\s\S]*?>[\s\S]*?<\/style>/gi, '')
    .replace(/<\/?[^>]+(>|$)/g, '')
    .trim();

const formatDate = (dateStr: string, details?: { year: string; month: string; day: string; hour: string; minutes: string }) => {
  if (!dateStr) return '';
  try {
    const date = new Date(dateStr);
    return date.toLocaleDateString('de-DE', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: details ? '2-digit' : undefined,
      minute: details ? '2-digit' : undefined,
    });
  } catch {
    return dateStr;
  }
};

const formatTime = (details: { hour: string; minutes: string }) => {
  return `${details.hour.padStart(2, '0')}:${details.minutes.padStart(2, '0')} Uhr`;
};

const getEventImage = (event: Event): string => {
  if (!event.image) return '/images/placeholder-800x450.jpg';
  
  // Bevorzuge medium_large, dann medium, dann original
  const img = event.image.sizes?.medium_large?.url || 
              event.image.sizes?.medium?.url || 
              event.image.url;
  return img;
};

/** Query-Parameter */
const pageParam = Astro.url.searchParams.get('page') || '1';
const perPage = 12;

/** Daten laden */
let events: Event[] = [];
let totalPages = 1;
let errorMsg = '';

try {
  const cacheBuster = `&_=${Date.now()}`;
  const apiUrl = `${EVENTS_API}?per_page=${perPage}&page=${pageParam}${cacheBuster}`;
  
  const res = await fetch(apiUrl, {
    headers: { 
      Accept: 'application/json',
      'Cache-Control': 'no-cache'
    },
  });
  
  if (!res.ok) throw new Error(`Events API HTTP ${res.status}`);
  
  const data = (await res.json()) as EventsResponse;
  events = data.events || [];
  totalPages = data.total_pages || 1;

  // Edge/Proxy-Caching: Kürzere Cache-Zeit für schnellere Updates
  try {
    Astro.response.headers.set(
      'Cache-Control',
      'public, s-maxage=60, stale-while-revalidate=300'
    );
  } catch {}
} catch (e: any) {
  errorMsg = `Konnte Events nicht laden (${e?.message ?? e}).`;
}
---

<Layout
  pageTitle="Events – Veranstaltungen | PLS EDV"
  description="Veranstaltungen und Events in der Region: Termine, Events und Aktivitäten."
  ogImage="/images/og-default.jpg"
  type="website"
  keywords={[
    'Events',
    'Veranstaltungen',
    'Termine',
    'Was wo finden',
  ]}
>

<section class="w-full py-14 md:py-20 bg-black text-white">
  <div class="mx-auto w-[75vw]">
    <h1 class="text-3xl md:text-5xl font-bold font-display tracking-wider">Events</h1>
    <p class="mt-4 text-lg text-white/80">
      Veranstaltungen und Termine in der Region
    </p>

    {errorMsg && (
      <div class="mt-8 rounded-lg border border-red-500/40 bg-red-500/10 p-4 text-red-200">
        <p class="font-semibold">Hinweis</p>
        <p class="mt-1">{errorMsg}</p>
      </div>
    )}

    {!errorMsg && events.length === 0 && (
      <div class="mt-10 text-white/80">Keine Events gefunden.</div>
    )}

    {!errorMsg && events.length > 0 && (
      <>
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
          {events.map((event) => {
            const img = getEventImage(event);
            const title = stripTags(event.title);
            const excerpt = stripTags(event.excerpt);
            const startDate = formatDate(event.start_date, event.start_date_details);
            const startTime = event.all_day ? '' : formatTime(event.start_date_details);
            const venue = event.venue?.venue || '';
            const city = event.venue?.city || '';
            
            return (
              <article class="min-w-0 rounded-xl overflow-hidden bg-white/5 border border-white/10">
                <a href={event.url} target="_blank" rel="noopener" class="block" aria-label={`Event ansehen: ${title}`}>
                  {img && (
                    <img src={img} alt={title} class="h-44 w-full object-cover" loading="lazy" />
                  )}
                  <div class="p-5">
                    <h2 class="text-xl font-semibold line-clamp-2">{title}</h2>
                    
                    <div class="mt-3 space-y-1 text-sm text-white/80">
                      {startDate && (
                        <p class="flex items-center gap-2">
                          <span class="text-white/60">📅</span>
                          <span>{startDate}{startTime && `, ${startTime}`}</span>
                        </p>
                      )}
                      {venue && (
                        <p class="flex items-center gap-2">
                          <span class="text-white/60">📍</span>
                          <span>{venue}{city && `, ${city}`}</span>
                        </p>
                      )}
                    </div>

                    {event.categories && event.categories.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-2 text-xs">
                        {event.categories.slice(0, 3).map((cat) => (
                          <span class="rounded bg-white/10 px-2 py-0.5">
                            {cat.name}
                          </span>
                        ))}
                      </div>
                    )}

                    {excerpt && <p class="mt-3 text-white/90 line-clamp-3">{excerpt}</p>}

                    <span class="mt-4 inline-block underline hover:no-underline">Zum Event →</span>
                  </div>
                </a>
              </article>
            );
          })}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <div class="mt-10 flex items-center justify-center gap-2">
            {Number(pageParam) > 1 && (
              <a 
                href={`/events?page=${Number(pageParam) - 1}`}
                class="rounded-lg border border-white/20 bg-white/5 px-4 py-2 hover:bg-white/10"
              >
                ← Zurück
              </a>
            )}
            <span class="text-white/60">
              Seite {pageParam} von {totalPages}
            </span>
            {Number(pageParam) < totalPages && (
              <a 
                href={`/events?page=${Number(pageParam) + 1}`}
                class="rounded-lg border border-white/20 bg-white/5 px-4 py-2 hover:bg-white/10"
              >
                Weiter →
              </a>
            )}
          </div>
        )}
      </>
    )}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
</style>
</Layout>

