  description="Webseite erstellen lassen in Buchholz i.d. Nordheide: Professionelle Websites für Unternehmen und Selbstständige. WordPress, Divi, SEO & Performance – PLS EDV aus Jesteburg."
  ogImage="/images/plsedvhome.jpg"
  type="article"
  publishedTime="2025-01-27"
  modifiedTime="2025-01-27"
  keywords={[
    'Webseite erstellen lassen Buchholz',
    'Webdesign Buchholz Nordheide',
    'Website Buchholz',
    'Homepage Buchholz',
    'WordPress Buchholz',
    'Landkreis Harburg',
    'Nordheide Webdesign'
  ]}
/>

<!-- Hero -->
<section
  class="relative isolate text-white bg-cover bg-center flex items-center min-h-[52svh] md:min-h-[68vh]"
  style="background-image:url('/images/plsedvhome.jpg');"
  aria-label="Webseite erstellen lassen in Buchholz i.d. Nordheide"
>
  <div class="absolute inset-0 bg-black/60"></div>
  <div class="relative z-10 mx-auto w-[75vw] py-16 md:py-24">
