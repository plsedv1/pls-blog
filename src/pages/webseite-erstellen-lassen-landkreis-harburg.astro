---
// Webseite erstellen lassen – Landkreis Harburg
import Layout from '../layouts/Layout.astro';
---

<Layout
  pageTitle="Webseite erstellen lassen im Landkreis Harburg | PLS EDV"
  description="Webseite erstellen lassen im Landkreis Harburg: Professionelle Websites für Unternehmen in Buchholz, Winsen, Seevetal, Jesteburg und Umgebung. WordPress, Divi, SEO & Performance – PLS EDV."
  ogImage="/images/plsedvhome.jpg"
  type="article"
  publishedTime="2025-01-27"
  modifiedTime="2025-01-27"
  keywords={[
    'Webseite erstellen lassen Landkreis Harburg',
    'Webdesign Landkreis Harburg',
    'Website Buchholz',
    'Webseite Winsen Luhe',
    'Webdesign Seevetal',
    'Homepage Jesteburg',
    'WordPress Agentur Nordheide'
  ]}
/>

<!-- Hero -->
<section
  class="relative isolate text-white bg-cover bg-center flex items-center min-h-[52svh] md:min-h-[68vh]"
  style="background-image:url('/images/plsedvhome.jpg');"
  aria-label="Webseite erstellen lassen im Landkreis Harburg"
>
  <div class="absolute inset-0 bg-black/60"></div>
  <div class="relative z-10 mx-auto w-[75vw] py-16 md:py-24">
    <h1 class="text-4xl md:text-6xl font-bold font-display tracking-wider">
      Webseite erstellen lassen im Landkreis Harburg
    </h1>
    <p class="mt-4 max-w-2xl text-lg md:text-xl text-white/90">
      Moderne, schnelle Websites für Unternehmen in Buchholz, Winsen, Seevetal, Rosengarten, Jesteburg und dem gesamten Landkreis Harburg – barrierearm, SEO-stark und leicht zu pflegen.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-4">
      <a href="/#kontakt" class="rounded bg-white px-6 py-3 text-ink hover:bg-gray-100 font-semibold">Kostenlose Erstberatung</a>
      <a href="/projekte" class="rounded border border-white px-6 py-3 hover:bg-white/10">Referenzen ansehen</a>
    </div>
  </div>
</section>

<!-- Nutzen -->
<section class="w-full py-16 md:py-24 bg-ink2 text-white">
  <div class="mx-auto w-[75vw] grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-7">
      <h2 class="text-2xl text-highlight">Warum PLS EDV im Landkreis Harburg?</h2>
      <h3 class="text-4xl font-bold py-4 font-display tracking-wider">
        Lokaler Ansprechpartner – professionelle Umsetzung
      </h3>
      <p class="text-white/90 leading-relaxed">
        Wer im <strong>Landkreis Harburg eine Webseite erstellen lassen</strong> möchte, profitiert von kurzen Wegen und persönlicher Betreuung. Von Buchholz über Winsen und Seevetal bis Jesteburg – ich realisiere Websites mit WordPress, Divi und modernen Standards: messbar schnell, barrierearm und suchmaschinenfreundlich.
      </p>
      <ul class="mt-6 space-y-2 text-white/90">
        <li>• Core Web Vitals & Lighthouse-Optimierung</li>
        <li>• WCAG-orientierte, barrierearme Umsetzung (A11y)</li>
        <li>• Editor-freundliche Strukturen (WordPress, Divi)</li>
        <li>• SEO für lokale Sichtbarkeit im Landkreis Harburg</li>
      </ul>
      <p class="mt-6 text-white/90">
        Weitere Leistungen: <a href="/webseite-erstellen-lassen-buchholz" class="underline hover:no-underline">Webseite Buchholz</a>,
        <a href="/webseite-erstellen-lassen-winsen" class="underline hover:no-underline">Webseite Winsen</a>,
        <a href="/webdesign-jesteburg" class="underline hover:no-underline">Webdesign Jesteburg</a>,
        <a href="/homepage-erstellen-lassen-hamburg-sued" class="underline hover:no-underline">Homepage Hamburg Süd</a>.
      </p>
    </div>
    <div class="lg:col-span-5">
      <div
        class="rounded-lg shadow-lg bg-cover bg-center min-h-[300px]"
        style="background-image:url('https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1600&auto=format&fit=crop')"
        aria-label="Professionelle Webseiten für den Landkreis Harburg"
      ></div>
    </div>
  </div>
</section>

<!-- Leistungen -->
<section class="w-full py-16 md:py-24 bg-black text-white">
  <div class="mx-auto w-[75vw]">
    <h2 class="text-2xl text-highlight">Leistungen</h2>
    <h3 class="text-4xl font-bold py-4 font-display tracking-wider">
      Webseite erstellen lassen – von der Idee bis zum Launch
    </h3>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      <article class="rounded-lg bg-white/5 border border-white/10 p-6">
        <h4 class="text-xl font-semibold">Konzept & Struktur</h4>
        <p class="mt-2 text-white/90">Ziele, Zielgruppen, Sitemap und Wireframes – klare Wege zu Kontakt und Anfragen.</p>
      </article>
      <article class="rounded-lg bg-white/5 border border-white/10 p-6">
        <h4 class="text-xl font-semibold">Design & WordPress/Divi</h4>
        <p class="mt-2 text-white/90">Markengerechtes Design, schlanke Themes, Divi-Module – leicht pflegbar für Sie.</p>
      </article>
      <article class="rounded-lg bg-white/5 border border-white/10 p-6">
        <h4 class="text-xl font-semibold">Performance & SEO</h4>
        <p class="mt-2 text-white/90">Schnelle Ladezeiten, lokale Suchoptimierung und Barrierefreiheit nach WCAG.</p>
      </article>
    </div>
  </div>
</section>

<!-- Orte im Landkreis -->
<section class="w-full py-16 md:py-24 bg-ink2 text-white">
  <div class="mx-auto w-[75vw]">
    <h2 class="text-2xl text-highlight">Ihre Region</h2>
    <h3 class="text-4xl font-bold py-4 font-display tracking-wider">
      Webseite erstellen lassen – in Ihrer Nähe
    </h3>
    <p class="max-w-3xl text-white/90 mt-4">
      Ich unterstütze Unternehmen und Selbstständige im gesamten Landkreis Harburg – unter anderem in Buchholz i.d. Nordheide, Winsen (Luhe), Seevetal, Rosengarten, Jesteburg, Stelle, Marschacht und Umgebung.
    </p>
    <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-4">
      <a href="/webseite-erstellen-lassen-buchholz" class="rounded-lg bg-white/5 border border-white/10 p-4 hover:bg-white/10 text-center">Buchholz</a>
      <a href="/webseite-erstellen-lassen-winsen" class="rounded-lg bg-white/5 border border-white/10 p-4 hover:bg-white/10 text-center">Winsen (Luhe)</a>
      <a href="/webseite-erstellen-lassen-seevetal" class="rounded-lg bg-white/5 border border-white/10 p-4 hover:bg-white/10 text-center">Seevetal</a>
      <a href="/webseite-erstellen-lassen-rosengarten" class="rounded-lg bg-white/5 border border-white/10 p-4 hover:bg-white/10 text-center">Rosengarten</a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="w-full py-16 md:py-24 bg-black text-white">
  <div class="mx-auto w-[75vw]">
    <h2 class="text-2xl text-highlight">FAQ</h2>
    <h3 class="text-4xl font-bold py-4 font-display tracking-wider">Häufige Fragen</h3>
    <div class="mt-8 space-y-6">
      <details class="rounded-lg bg-white/5 border border-white/10 p-5">
        <summary class="cursor-pointer text-lg font-semibold">Wie lange dauert die Erstellung einer Webseite?</summary>
        <p class="mt-3 text-white/90">Je nach Umfang 3–8 Wochen. Gute Vorbereitung (Texte, Bilder) und zügige Abstimmungen beschleunigen den Prozess.</p>
      </details>
      <details class="rounded-lg bg-white/5 border border-white/10 p-5">
        <summary class="cursor-pointer text-lg font-semibold">Kommen Sie auch zu mir in den Landkreis Harburg?</summary>
        <p class="mt-3 text-white/90">Ja. Vor-Ort-Termine in Buchholz, Winsen, Seevetal, Jesteburg und Umgebung sind möglich; viele Projekte lassen sich auch remote effizient umsetzen.</p>
      </details>
      <details class="rounded-lg bg-white/5 border border-white/10 p-5">
        <summary class="cursor-pointer text-lg font-semibold">Ist die Webseite später selbst pflegbar?</summary>
        <p class="mt-3 text-white/90">Ja. Mit WordPress und Divi können Sie Inhalte selbst aktualisieren; auf Wunsch mit kurzer Einweisung oder Redaktions-Guide.</p>
      </details>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="w-full py-16 md:py-24 bg-ink2 text-white text-center">
  <div class="mx-auto w-[75vw]">
    <h3 class="text-3xl md:text-4xl font-bold font-display tracking-wider">
      Webseite erstellen lassen im Landkreis Harburg?
    </h3>
    <p class="mt-4 text-lg text-white/90">Kostenloses Erstgespräch – von der Idee bis zum Launch.</p>
    <div class="mt-8">
      <a href="/#kontakt" class="rounded bg-white px-6 py-3 text-ink hover:bg-gray-100 font-semibold">Jetzt Kontakt aufnehmen</a>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Webseite erstellen lassen Landkreis Harburg",
  "provider": {
    "@type": "Organization",
    "name": "PLS EDV – Philipp Leser",
    "url": "https://www.pls-edv.de",
    "areaServed": ["Landkreis Harburg", "Buchholz", "Winsen", "Seevetal", "Rosengarten", "Jesteburg", "Nordheide"]
  },
  "description": "Professionelle Webseiten für Unternehmen im Landkreis Harburg: Buchholz, Winsen, Seevetal, Rosengarten, Jesteburg. WordPress, Divi, SEO und Barrierefreiheit."
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {"@type": "Question", "name": "Wie lange dauert die Erstellung einer Webseite?", "acceptedAnswer": {"@type": "Answer", "text": "Je nach Umfang 3–8 Wochen."}},
    {"@type": "Question", "name": "Kommen Sie auch in den Landkreis Harburg?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, Vor-Ort-Termine in Buchholz, Winsen, Seevetal, Jesteburg und Umgebung sind möglich."}},
    {"@type": "Question", "name": "Ist die Webseite später selbst pflegbar?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, mit WordPress und Divi können Sie Inhalte selbst aktualisieren."}}
  ]
}
</script>
